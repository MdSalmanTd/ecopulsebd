# Copy this file to .env.local (or .env) and fill in the values. Never commit the real file.

# Secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# PostgreSQL connection string (Neon, Supabase, Railway, local …). Tables are created automatically.
# Leave empty in development to use the embedded PGlite database in ./data/pglite.
# Hosted providers usually need SSL, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Redis connection string for rate limiting (Upstash, Redis Cloud, local …),
# e.g. redis://localhost:6379 or rediss://default:<password>@<host>:6379
# Leave empty to use in-memory limits.
REDIS_URL=

# ---- AI assistant (Claude) ----
# API key from https://platform.claude.com — turns on AI answers on the Assistant page.
# Leave empty to use the built-in (rule-based) answers.
ANTHROPIC_API_KEY=
# Optional API link: only set this to route requests through a proxy/gateway.
# Leave empty to use Anthropic's default API (https://api.anthropic.com).
ANTHROPIC_BASE_URL=
# Optional model id (default: claude-opus-5-5).
AI_MODEL=
# Set to "false" if your gateway doesn't support server-side fallbacks.
AI_FALLBACKS=

# Set to "false" to skip creating the demo account (nadia@example.com / ecopulse123).
SEED_DEMO=true

# ---- Eco Shop ----
# Online payment currently uses a built-in DEMO step (no money moves).
# Set to "false" to switch it off (cash on delivery and Eco Coins still work) until a real gateway is connected.
PAYMENTS_DEMO=
